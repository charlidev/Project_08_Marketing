table fact_campanias
	lineageTag: d852a5a1-739a-4004-b266-50dd997bd747

	/// Porcentaje de clientes que respondieron positivamente a la última campaña de marketing.
	measure 'Tasa Respuesta Última Campaña' = DIVIDE( SUM( fact_campanias[Response] ), [Total Clientes] )
		formatString: 0.0%
		displayFolder: Visión General del Cliente
		lineageTag: 002d9258-bad7-42a3-8826-2f891daba6e6

	/// Número de clientes que presentaron al menos una queja en los últimos 2 años.
	measure 'Clientes con Quejas' = SUM( fact_campanias[Complain] )
		formatString: #,0
		displayFolder: Visión General del Cliente
		lineageTag: c3647d49-35df-425a-a839-40f9b9d42643

	/// Porcentaje de clientes que aceptaron la Campaña 1.
	measure 'Tasa Aceptación Cmp1' = DIVIDE( SUM( fact_campanias[AcceptedCmp1] ), [Total Clientes] )
		formatString: 0.0%
		displayFolder: Análisis de Campañas
		lineageTag: 065e77c9-a5f4-461b-a3b6-0c424ecd0a1d

	/// Porcentaje de clientes que aceptaron la Campaña 2.
	measure 'Tasa Aceptación Cmp2' = DIVIDE( SUM( fact_campanias[AcceptedCmp2] ), [Total Clientes] )
		formatString: 0.0%
		displayFolder: Análisis de Campañas
		lineageTag: 3cb9ce7b-4d0c-4166-8181-1788f32de36b

	/// Porcentaje de clientes que aceptaron la Campaña 3.
	measure 'Tasa Aceptación Cmp3' = DIVIDE( SUM( fact_campanias[AcceptedCmp3] ), [Total Clientes] )
		formatString: 0.0%
		displayFolder: Análisis de Campañas
		lineageTag: 61a2e049-65e5-4301-805c-2318c1447e0c

	/// Porcentaje de clientes que aceptaron la Campaña 4.
	measure 'Tasa Aceptación Cmp4' = DIVIDE( SUM( fact_campanias[AcceptedCmp4] ), [Total Clientes] )
		formatString: 0.0%
		displayFolder: Análisis de Campañas
		lineageTag: ad2407cc-2d9e-45e4-a1a8-12e1c811d7f0

	/// Porcentaje de clientes que aceptaron la Campaña 5.
	measure 'Tasa Aceptación Cmp5' = DIVIDE( SUM( fact_campanias[AcceptedCmp5] ), [Total Clientes] )
		formatString: 0.0%
		displayFolder: Análisis de Campañas
		lineageTag: ad13a710-08c6-4934-bfee-776ffa2a2b5a

	/// Promedio de campañas aceptadas por cliente (0 a 5). Indica el nivel de engagement acumulado.
	measure 'Campañas Aceptadas Promedio' = AVERAGE( fact_campanias[AcceptedCmpOverall] )
		formatString: 0.00
		displayFolder: Análisis de Campañas
		lineageTag: 7661b725-b48a-40d4-8185-90e6292fc2f4

	/// Número de clientes que aceptaron más de una campaña.
	measure 'Clientes Multirespuesta' = COUNTROWS( FILTER( fact_campanias, fact_campanias[AcceptedCmpOverall] > 1 ) )
		formatString: #,0
		displayFolder: Análisis de Campañas
		lineageTag: 4f7a122b-8a3c-4947-a9cd-f3c6469b9035

	/// Ingreso promedio de los clientes que respondieron a la última campaña.
	measure 'Ingreso Promedio Respondedores' = CALCULATE( AVERAGE( dim_clientes[Income] ), fact_campanias[Response] = 1 )
		formatString: $ #,0
		displayFolder: Análisis de Campañas
		lineageTag: 6a7c0331-08e4-4dc9-86b4-eecab2d00d64

	/// Ingreso promedio de los clientes que NO respondieron a la última campaña.
	measure 'Ingreso Promedio No Respondedores' = CALCULATE( AVERAGE( dim_clientes[Income] ), fact_campanias[Response] = 0 )
		formatString: $ #,0
		displayFolder: Análisis de Campañas
		lineageTag: 675e9b4f-50fe-49bf-861e-e1d916fbda6f

	/// Edad promedio de los clientes que respondieron a la última campaña.
	measure 'Edad Promedio Respondedores' = CALCULATE( AVERAGE( dim_clientes[Age] ), fact_campanias[Response] = 1 )
		formatString: 0.0
		displayFolder: Análisis de Campañas
		lineageTag: 89e09bc6-cc03-459c-a69d-6d8c3e263dd3

	/// Porcentaje de clientes con queja que también respondieron a la última campaña.
	measure 'Tasa Queja entre Respondedores' = CALCULATE( DIVIDE( SUM( fact_campanias[Complain] ), [Total Clientes] ), fact_campanias[Response] = 1 )
		formatString: 0.0%
		displayFolder: Análisis de Campañas
		lineageTag: a3f21f1c-9376-4b9b-a478-bde31d68ec83

	/// Promedio de campañas aceptadas en el contexto de filtro (e.g., por rango de Customer_Days). Mide si los clientes más antiguos son más receptivos.
	measure 'Campañas Aceptadas Prom (por Antigüedad)' = AVERAGE( fact_campanias[AcceptedCmpOverall] )
		formatString: 0.00
		displayFolder: Perfil del Cliente Ideal
		lineageTag: d35db90b-f1f8-4f3f-93e7-3099c53fa11c

